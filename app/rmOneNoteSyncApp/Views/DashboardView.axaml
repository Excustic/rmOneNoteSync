<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:rmOneNoteSyncApp.ViewModels"
             xmlns:models="using:rmOneNoteSyncApp.Models"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="700"
             x:Class="rmOneNoteSyncApp.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             x:Name="DashboardRoot">
    
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Margin="30">
            <TextBlock Classes="section-title" Text="Dashboard"/>
            
            <!-- Device Info Card -->
            <Border Background="White" CornerRadius="8" BoxShadow="0 2 10 0 #10000000" Padding="20">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Grid.Column="0" Margin="0,0,40,0">
                        <PathIcon Data="M17,2H7A2,2 0 0,0 5,4V20A2,2 0 0,0 7,22H17A2,2 0 0,0 19,20V4A2,2 0 0,0 17,2M7,4H17V20H7V4Z"
                                 Width="64" Height="64" Foreground="#3a3d4e"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="{Binding DeviceDisplayName}" FontSize="20" FontWeight="SemiBold"/>
                        
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Status:" Foreground="#666" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding DeviceStatus}" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding IsConnected, Converter={StaticResource BoolToStatusColorConverter}}"/>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <Button Content="Scan for device"
                                        Classes="small stroke"
                                        IsVisible="{Binding RequiresManualScan}"
                                        Command="{Binding ScanForDeviceCommand}"
                                        Padding="8,4"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="IP Address:" Foreground="#666"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceIp, FallbackValue='--'}"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Connected:" Foreground="#666"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastConnected, FallbackValue='Never'}"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Backend Server:" Foreground="#666" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding IsServerRunning, Converter={StaticResource BoolToStatusBrushConverter}}"/>
                                <TextBlock Text="{Binding ServerStatusText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Button Content="Start Server" 
                                        Classes="small stroke" 
                                        IsVisible="{Binding !IsServerRunning}"
                                        Command="{Binding StartServerCommand}"
                                        Padding="8,4" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- My Synced Notebooks -->
            <Border Background="White" CornerRadius="8" BoxShadow="0 2 10 0 #10000000" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding SyncedStatsText, StringFormat='{}My Synced Notebooks - {0}'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SyncedNotebooks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DocumentMetadata">
                                    <Grid Margin="0,0,15,15" Width="200" Height="135">
                                        <Button Command="{ReflectionBinding #DashboardRoot.DataContext.OpenUrlCommand}"
                                                CommandParameter="{Binding OneNoteUrl}"
                                                Background="#f8fafc"
                                                BorderBrush="#e2e8f0"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Padding="15">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                                          Width="32" Height="32" Foreground="#2563eb"/>
                                                <TextBlock Text="{Binding VisibleName}" FontWeight="SemiBold" TextAlignment="Center" Width="160" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VisibleName}"/>
                                                <TextBlock Text="{Binding VirtualPath}" Foreground="#94a3b8" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160" ToolTip.Tip="{Binding VirtualPath}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                    <PathIcon Data="M12,18A6,6 0 0,1 6,12C6,11 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20V23L16,19L12,15M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13 17.75,13.97 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4Z" 
                                                              Width="12" Height="12" Foreground="#64748b"/>
                                                    <TextBlock Text="{Binding CustomMetadata[LastSyncTime], FallbackValue='Never', TargetNullValue='Never'}" Foreground="#64748b" FontSize="12" TextAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button Background="Transparent" 
                                                VerticalAlignment="Top" 
                                                HorizontalAlignment="Right"
                                                Margin="0,5,5,0" 
                                                Padding="5">
                                            <PathIcon Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z" Width="16" Height="16" Foreground="#64748b"/>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Sync Manually" 
                                                              Command="{ReflectionBinding #DashboardRoot.DataContext.OpenManualSyncCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Rename Notebook" 
                                                              Command="{ReflectionBinding #DashboardRoot.DataContext.BeginRenameCommand}"
                                                              CommandParameter="{Binding}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Unsynced Notebooks -->
            <Border Background="White" CornerRadius="8" BoxShadow="0 2 10 0 #10000000" Padding="20" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding UnsyncedStatsText, StringFormat='{}Unsynced Notebooks - {0}'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding UnsyncedNotebooks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DocumentMetadata">
                                    <Grid Margin="0,0,15,15" Width="200" Height="135">
                                        <Border Background="#f1f5f9"
                                                BorderBrush="#e2e8f0"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Padding="15">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                                          Width="32" Height="32" Foreground="#94a3b8"/>
                                                <TextBlock Text="{Binding VisibleName}" Foreground="#475569" FontWeight="SemiBold" TextAlignment="Center" Width="160" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding VisibleName}"/>
                                                <!-- Virtual Path field (grey and smaller) -->
                                                <TextBlock Text="{Binding VirtualPath}" Foreground="#94a3b8" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160" ToolTip.Tip="{Binding VirtualPath}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                    <PathIcon Data="M12,18A6,6 0 0,1 6,12C6,11 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20V23L16,19L12,15M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13 17.75,13.97 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4Z" 
                                                              Width="12" Height="12" Foreground="#94a3b8"/>
                                                    <TextBlock Text="Not synced yet" Foreground="#94a3b8" FontSize="12" TextAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Button Background="Transparent" 
                                                VerticalAlignment="Top" 
                                                HorizontalAlignment="Right"
                                                Margin="0,5,5,0" 
                                                Padding="5">
                                            <PathIcon Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z" Width="16" Height="16" Foreground="#64748b"/>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Sync Manually" 
                                                              Command="{ReflectionBinding #DashboardRoot.DataContext.OpenManualSyncCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Rename Notebook" 
                                                              Command="{ReflectionBinding #DashboardRoot.DataContext.BeginRenameCommand}"
                                                              CommandParameter="{Binding}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            
            <!-- Recent Activity -->
            <Border Background="White" CornerRadius="8" BoxShadow="0 2 10 0 #10000000" Padding="20">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Recent Activity" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <Button DockPanel.Dock="Right" Background="Transparent" Content="Refresh" Command="{Binding RefreshRecentActivityCommand}">
                            <PathIcon Data="M497.408 898.56c-.08-.193-.272-.323-.385-.483l-91.92-143.664c-6.528-10.72-20.688-14.527-31.728-8.512l-8.193 5.04c-11.007 6-10.767 21.537-4.255 32.256l58.927 91.409c-5.024-1.104-10.096-2-15.056-3.296-103.184-26.993-190.495-96.832-239.535-191.6-46.336-89.52-55.04-191.695-24.512-287.743 30.512-96.048 99.775-174.464 189.295-220.784 15.248-7.888 21.2-26.64 13.312-41.856-7.872-15.264-26.64-21.231-41.855-13.327-104.272 53.952-184.4 145.28-219.969 257.152C45.982 485.008 56.11 604.033 110.078 708.29c57.136 110.336 158.832 191.664 279.024 223.136 1.36.352 2.784.56 4.16.911l-81.311 41.233c-11.008 6.032-14.657 19.631-8.128 30.351l3.152 8.176c6.56 10.72 17.84 14.527 28.815 8.512L484.622 944.4c.193-.128.385-.096.578-.224l9.984-5.456c5.52-3.024 9.168-7.969 10.624-13.505 1.52-5.52.815-11.663-2.448-16.991zm416.496-577.747c-57.056-110.304-155.586-191.63-275.762-223.118-8.56-2.24-17.311-3.984-26.048-5.712l79.824-40.48c11.008-6.033 17.568-19.632 11.04-30.369l-3.153-8.16c-6.56-10.736-20.752-14.528-31.727-8.528L519.262 80.654c-.176.112-.384.08-.577.208l-9.967 5.472c-5.537 3.04-9.168 7.967-10.624 13.503-1.52 5.52-.816 11.648 2.464 16.976l5.92 9.712c.096.192.272.305.384.497l91.92 143.648c6.512 10.736 20.688 14.528 31.712 8.513l7.216-5.025c11.008-6 11.727-21.536 5.231-32.24l-59.2-91.856c13.008 2 25.968 4.416 38.624 7.76 103.232 27.04 187.393 96.864 236.4 191.568 46.32 89.519 55.024 191.695 24.48 287.728-30.511 96.047-96.655 174.448-186.174 220.816-15.233 7.887-21.168 26.607-13.28 41.87 5.519 10.64 16.335 16.768 27.599 16.768 4.8 0 9.664-1.12 14.272-3.488 104.272-53.936 181.248-145.279 216.816-257.119 35.536-111.904 25.393-230.929-28.574-335.152z" 
                                                        Width="16" Height="16" Foreground="Gray"/>
                        </Button>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding RecentActivities}"
                                AutoGenerateColumns="False"
                                CanUserReorderColumns="False"
                                CanUserResizeColumns="True"
                                GridLinesVisibility="Horizontal"
                                BorderThickness="0"
                                MinHeight="200"
                                MaxHeight="300"
                                HorizontalAlignment="Stretch"
                                IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date&amp;Time" 
                                                Binding="{Binding Timestamp, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}', Mode=OneWay}" 
                                                Width="180"/>
                            <DataGridTextColumn Header="Content" 
                                                Binding="{Binding FormattedLogContent, Mode=OneWay}" 
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>