<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:rmOneNoteSyncApp.ViewModels"
        x:Class="rmOneNoteSyncApp.Views.InputDialogWindow"
        x:DataType="vm:InputDialogViewModel"
        Title="{Binding Title}"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid RowDefinitions="*,Auto,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="{Binding Message}"
                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,10"/>

        <TextBox Grid.Row="1" Text="{Binding InputText}"
                 Watermark="{Binding Watermark}"
                 VerticalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="OK" Command="{Binding ConfirmCommand}" Classes="primary" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
