<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:rmOneNoteSyncApp.ViewModels"
        xmlns:views="using:rmOneNoteSyncApp.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="rmOneNoteSyncApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="reMarkable OneNote Sync"
        Width="1600" Height="1200"
        MinWidth="1300" MinHeight="900"
        WindowStartupLocation="CenterScreen">
    
    <Window.Styles>
        <!-- Define the app's color scheme and styles -->
        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="#1a1d2e"/>
        </Style>
        
        <Style Selector="Button.nav-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style Selector="Button.nav-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#228789ff"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <Style Selector="Button.nav-button.selected">
            <Setter Property="Background" Value="#3a3d4e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </Window.Styles>
    
    <Grid>
        <!-- Show setup screen if not configured, otherwise show main interface -->
        <Panel>
            <!-- Setup Screen (shown when device not configured) -->
            <views:SetupView IsVisible="{Binding ShowSetupScreen}"/>
            
            <!-- Main Interface (shown when configured) -->
            <Grid IsVisible="{Binding !ShowSetupScreen}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left Sidebar Navigation -->
                <Border Grid.Column="0" Classes="sidebar" VerticalAlignment="Stretch">
                    <DockPanel LastChildFill="False"> 
                        <!-- App Logo/Title -->
                        <Border DockPanel.Dock="Top" Padding="20,25" BorderBrush="#2a2d3e" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                <Image Source="/Assets/app-icon.png" Width="96" Height="96"/>
                                <StackPanel Margin="0,24,0,0">
                                    <TextBlock Text="reMarkable" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                    <StackPanel Orientation="Vertical" Spacing="6" Margin="0,2,0,0">
                                        <TextBlock Text="OneNote Sync" FontSize="14" Foreground="#a0a0a0"/>
                                        <Border Background="#3a3d4e" CornerRadius="4" Padding="4,2">
                                            <TextBlock Text="{Binding AppVersion}" FontSize="10" Foreground="#d1d5db" FontWeight="Medium"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Navigation Buttons -->
                        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,10">
                                <Button Classes="nav-button" 
                                        Classes.selected="{Binding CurrentView, Converter={StaticResource EqualityConverter}, ConverterParameter=Dashboard}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Dashboard">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" 
                                                 Width="18" Height="18" Foreground="{Binding $parent[Button].Foreground}"/>
                                        <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Classes="nav-button"
                                        Classes.selected="{Binding CurrentView, Converter={StaticResource EqualityConverter}, ConverterParameter=FileBrowser}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="FileBrowser">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" 
                                                 Width="18" Height="18" Foreground="{Binding $parent[Button].Foreground}"/>
                                        <TextBlock Text="File Browser" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Classes="nav-button"
                                        Classes.selected="{Binding CurrentView, Converter={StaticResource EqualityConverter}, ConverterParameter=SyncStatus}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="SyncStatus">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Data="M12,18.17L8.83,15L7.42,16.41L12,21L16.59,16.41L15.17,15M12,5.83L15.17,9L16.58,7.59L12,3L7.41,7.59L8.83,9L12,5.83Z" 
                                                 Width="18" Height="18" Foreground="{Binding $parent[Button].Foreground}"/>
                                        <TextBlock Text="Sync Status" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                
                                <Button Classes="nav-button"
                                        Classes.selected="{Binding CurrentView, Converter={StaticResource EqualityConverter}, ConverterParameter=Logs}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Logs">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" 
                                                 Width="18" Height="18" Foreground="{Binding $parent[Button].Foreground}"/>
                                        <TextBlock Text="Logs" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                                                
                                <Button Classes="nav-button"
                                        Classes.selected="{Binding CurrentView, Converter={StaticResource EqualityConverter}, ConverterParameter=Settings}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="Settings">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Data="M19.4,13c0-0.3,0.1-0.7,0.1-1s0-0.7-0.1-1l2.1-1.5c0.2-0.1,0.3-0.4,0.1-0.7l-2-3.5C19.5,5,19.2,4.9,19,5l-2.4,1.1
                                            c-0.5-0.4-1.2-0.8-1.8-1l-0.3-2.6C14.5,2.2,14.3,2,14,2h-4C9.7,2,9.5,2.2,9.5,2.5L9.2,5C8.5,5.3,7.9,5.6,7.4,6L5,5
                                            C4.8,4.9,4.5,5,4.4,5.2l-2,3.5C2.2,9,2.2,9.3,2.5,9.4L4.6,11c0,0.3-0.1,0.7-0.1,1s0,0.7,0.1,1l-2.1,1.5c-0.2,0.1-0.3,0.4-0.1,0.7
                                            l2,3.5C4.5,19,4.8,19.1,5,19l2.4-1.1c0.5,0.4,1.2,0.8,1.8,1l0.3,2.6c0,0.3,0.2,0.5,0.5,0.5h4c0.3,0,0.5-0.2,0.5-0.5l0.3-2.6
                                            c0.7-0.3,1.3-0.6,1.8-1L19,19c0.2,0.1,0.5,0,0.6-0.2l2-3.5c0.1-0.2,0.1-0.5-0.1-0.7L19.4,13z M12,16c-2.2,0-4-1.8-4-4s1.8-4,4-4
                                            s4,1.8,4,4S14.2,16,12,16z" 
                                                 Width="18" Height="18" Foreground="{Binding $parent[Button].Foreground}"/>
                                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        
                        <!-- Connection Status at Bottom -->
                        <Border
                            DockPanel.Dock="Top"
                            BorderBrush="#2a2d3e" 
                            BorderThickness="0,1,0,0" 
                            Padding="20,15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding ConnectionState, Converter={StaticResource ConnectionStateToColorConverter}}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ConnectionStateText}" 
                                              Foreground="#a0a0a0" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentDevice.IpAddress, FallbackValue='Not connected'}"
                                           Foreground="#707070" FontSize="11" Margin="0,4,0,8"/>
                            </StackPanel>
                        </Border>

                        <!-- About section -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom">
                                <!-- GitHub button -->
                                <Button
                                        Classes="nav-button"
                                        Command="{Binding OpenRepositoryURLCommand}"
                                        Padding="6,4"
                                        Background="Transparent"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                    <!-- small GitHub icon (inline Path) -->
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="24" Height="24">
                                        <Path Data="M12,2C6.48,2 2,6.48 2,12c0,4.42 2.87,8.17 6.84,9.49.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.71-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1.01.07 1.54 1.04 1.54 1.04.9 1.54 2.36 1.1 2.94.84.09-.66.35-1.1.63-1.35-2.22-.25-4.55-1.11-4.55-4.93 0-1.09.39-1.98 1.02-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85.004 1.71.115 2.51.34 1.9-1.29 2.74-1.02 2.74-1.02.55 1.38.2 2.4.1 2.65.63.7 1.02 1.59 1.02 2.68 0 3.83-2.34 4.68-4.57 4.92.36.31.68.92.68 1.85 0 1.33-.01 2.4-.01 2.73 0 .26.18.58.69.48A10.01 10.01 0 0 0 22 12c0-5.52-4.48-10-10-10z"
                                                Fill="#a0a0a0"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="GitHub" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <!-- Copyright -->
                                <TextBlock Text="Made by Excustic - GPL3.0"
                                            Foreground="#a0a0a0"
                                            FontSize="12"
                                            VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Bottom" Background="#3b82f6" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                                Opacity="{Binding UpdateBannerOpacity}"
                                IsHitTestVisible="{Binding IsUpdateAvailable}"
                                BoxShadow="0 4 6 -1 #10000000">
                            
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="SineEaseInOut"/>
                                </Transitions>
                            </Border.Transitions>

                            <StackPanel Spacing="10" Orientation="Horizontal">
                                <TextBlock Text="✨ New Update Available!" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                <Button Content="{Binding UpdateButtonText}" 
                                        Command="{Binding OpenUpdateUrlCommand}"
                                        Background="{Binding UpdateButtonBg}" 
                                        Foreground="{Binding UpdateButtonFg}" 
                                        FontSize="12" Padding="8,4" CornerRadius="4"
                                        HorizontalAlignment="Left" Cursor="Hand">
                                    <Button.Transitions>
                                        <Transitions>
                                            <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                            <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                                        </Transitions>
                                    </Button.Transitions>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Background="rgba(255, 30, 50, 0.7)" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                                Opacity="{Binding DeployBannerOpacity}"
                                IsHitTestVisible="{Binding NeedsDeployment}"
                                BoxShadow="0 4 6 -1 #10000000">
                            
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="SineEaseInOut"/>
                                </Transitions>
                            </Border.Transitions>

                            <StackPanel Spacing="10" Orientation="Horizontal">
                                <TextBlock Text="Missing latest sync firmware" VerticalAlignment="Center" Foreground="White" FontWeight="Light" FontSize="12"/>
                                <Button Content="{Binding DeployButtonText}" 
                                        Command="{Binding DeployServiceCommand}"
                                        Background="{Binding DeployButtonBg}" 
                                        Foreground="{Binding DeployButtonFg}" 
                                        FontSize="12" Padding="8,4" CornerRadius="4"
                                        HorizontalAlignment="Left" Cursor="Hand">
                                    <Button.Transitions>
                                        <Transitions>
                                            <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                            <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                                        </Transitions>
                                    </Button.Transitions>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>
                
                <!-- Main Content Area -->
                <Border Grid.Column="1" Background="#f5f6fa">
                    <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}">
                        <ContentControl.DataTemplates>
                            <!-- Define how each ViewModel maps to its View -->
                            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                                <views:DashboardView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                <views:SettingsView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:FolderPickerViewModel}">
                                <views:FileBrowserView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SyncStatusViewModel}">
                                <views:SyncStatusView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                                <views:LogsView></views:LogsView>
                            </DataTemplate>
                            <!-- Add other view mappings -->
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </Border>
            </Grid>
            <!-- Guided Tour Overlay -->
            <Border Background="#B3000000" IsVisible="{Binding IsTourVisible}" ZIndex="100">
                <Border Background="White" CornerRadius="12" Padding="32" Width="550" 
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BoxShadow="0 15 30 0 #60000000">
                    <StackPanel Spacing="24">
                        
                        <!-- Slide 1 -->
                        <StackPanel Spacing="16" IsVisible="{Binding CurrentTourStep, Converter={StaticResource EqualityConverter}, ConverterParameter=1}">
                            <TextBlock Text="Welcome to rmOneNoteSync! 👋" FontWeight="Bold" FontSize="24" Foreground="#1a1d2e"/>
                            <TextBlock Text="This is a two-part system. The main application runs right here on your PC, while a lightweight service runs quietly on your reMarkable tablet. Let's take a quick tour!" TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="24"/>
                        </StackPanel>

                        <!-- Slide 2 -->
                        <StackPanel Spacing="16" IsVisible="{Binding CurrentTourStep, Converter={StaticResource EqualityConverter}, ConverterParameter=2}">
                            <TextBlock Text="Settings - Device &amp; PC ⚙️" FontWeight="Bold" FontSize="24" Foreground="#1a1d2e"/>
                            <TextBlock Text="Notice how we've jumped to the Settings tab in the background! 'Device Connection' options affect how your PC communicates with your tablet. 'Sync Interval' controls how often a 'sync cycle' is triggered. During a sync cycle, the service on your tablet automatically packages and sends changes. Since you're signed in to Microsoft, you're all set here!" TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="24"/>
                        </StackPanel>

                        <!-- Slide 3 -->
                        <StackPanel Spacing="16" IsVisible="{Binding CurrentTourStep, Converter={StaticResource EqualityConverter}, ConverterParameter=3}">
                            <TextBlock Text="Choose Your Notebooks 📁" FontWeight="Bold" FontSize="24" Foreground="#1a1d2e"/>
                            <TextBlock Text="Select the specific folders or notebooks you want to track. Once selected, the service running on your reMarkable checks them constantly and starts syncing them automatically. Your 'potential OneNote notebook candiadtes' will appear in your dashboard once you've clicked 'Load Files' in the file browser." TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="24"/>
                        </StackPanel>

                        <!-- Slide 4 -->
                        <StackPanel Spacing="16" IsVisible="{Binding CurrentTourStep, Converter={StaticResource EqualityConverter}, ConverterParameter=4}">
                            <TextBlock Text="Monitoring Sync 🔄" FontWeight="Bold" FontSize="24" Foreground="#1a1d2e"/>
                            <TextBlock Text="The Sync Status panel shows your notebooks being processed and uploaded to the Microsoft Cloud. Your tablet sends these automatically based on your sync interval. If you wish to trigger sync for pre-existing files, hit the 'Manual Sync' button on Notebook candidates in the dashboard to push your edits to OneNote at the next sync cycle." TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="24"/>
                            <TextBlock Text="Tip: Microsoft has API limits! Pushing 50 pages manually at once might fail. It's best to do updates in short batches." TextWrapping="Wrap" Foreground="#3b82f6" FontWeight="SemiBold" FontSize="14" LineHeight="22"/>
                        </StackPanel>

                        <!-- Slide 5 -->
                        <StackPanel Spacing="16" IsVisible="{Binding CurrentTourStep, Converter={StaticResource EqualityConverter}, ConverterParameter=5}">
                            <TextBlock Text="Your Dashboard 🏠" FontWeight="Bold" FontSize="24" Foreground="#1a1d2e"/>
                            <TextBlock Text="Once uploaded, your pages appear right here on the Dashboard with 1-click links to open them directly in OneNote. Note the structure structure: rmOneNoteSync leverages parent folders as OneNote Notebooks, and the containing .rm files as Sections. E.g. Academy/Math/Combinatorics.rm will appear as a 'Combinatorics' section in the rm_Academy_Math notebook in OneNote." TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="24"/>
                        </StackPanel>
                        
                        <!-- Slide 6 -->
                        <StackPanel Spacing="16" IsVisible="{Binding CurrentTourStep, Converter={StaticResource EqualityConverter}, ConverterParameter=6}">
                            <TextBlock Text="Under The Hood 📝" FontWeight="Bold" FontSize="24" Foreground="#1a1d2e"/>
                            <TextBlock Text="If something ever goes wrong or gets stuck, the Logs tab shows you the raw activity of both the desktop app and the tablet service. You're ready to go!" TextWrapping="Wrap" Foreground="#404040" FontSize="15" LineHeight="24"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                            <Button Content="Skip Tour" Command="{Binding DismissTourCommand}" Classes="nav-button" Foreground="#707070" Padding="12,8" Background="Transparent"/>
                            <Button Content="{Binding ProceedButtonText}" Command="{Binding NextTourStepCommand}" Background="#3b82f6" Foreground="White" Padding="20,10" CornerRadius="6" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Panel>
    </Grid>
</Window>