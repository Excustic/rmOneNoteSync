<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:rmOneNoteSyncApp.ViewModels"
             xmlns:models="using:rmOneNoteSyncApp.Models"
             x:Class="rmOneNoteSyncApp.Views.SyncStatusView"
             x:DataType="vm:SyncStatusViewModel">
    
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Margin="30">
            <TextBlock Classes="section-title" Text="Sync Status"/>
            
            <!-- Server Status Card -->
            <Border Background="White" CornerRadius="8" BoxShadow="0 2 10 0 #10000000" Padding="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="10">
                        <TextBlock Text="Sync Server" FontSize="18" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="10" Height="10">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding IsServerRunning, 
                                        Converter={StaticResource BoolToStatusColorConverter}}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding ServerStatus}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button Content="Start Server" 
                                Command="{Binding StartServerCommand}"
                                IsVisible="{Binding !IsServerRunning}"
                                Classes="primary"/>
                        <Button Content="Stop Server" 
                                Command="{Binding StopServerCommand}"
                                IsVisible="{Binding IsServerRunning}"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Statistics Cards -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="20">
                <Border Grid.Column="0" Background="White" CornerRadius="8" 
                        BoxShadow="0 2 10 0 #10000000" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Received" Foreground="#666" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding TotalReceivedNotebooks}" FontSize="24" FontWeight="Bold" Foreground="#3b82f6"/>
                            <TextBlock Text="Notebooks, " VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="11" Foreground="#9ca3af"/>
                            <TextBlock Text="{Binding TotalReceivedPages}" FontSize="24" FontWeight="Bold" Foreground="#3b82f6"/>
                            <TextBlock Text="Pages" VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="11" Foreground="#9ca3af"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Background="White" CornerRadius="8" 
                        BoxShadow="0 2 10 0 #10000000" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Pending" Foreground="#666" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding TotalPendingNotebooks}" FontSize="24" FontWeight="Bold" Foreground="#f59e0b"/>
                            <TextBlock Text="Notebooks, " VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="11" Foreground="#9ca3af"/>
                            <TextBlock Text="{Binding TotalPendingPages}" FontSize="24" FontWeight="Bold" Foreground="#f59e0b"/>
                            <TextBlock Text="Pages" VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="11" Foreground="#9ca3af"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="2" Background="White" CornerRadius="8" 
                        BoxShadow="0 2 10 0 #10000000" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Uploaded" Foreground="#666" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding TotalUploadedNotebooks}" FontSize="24" FontWeight="Bold" Foreground="#10b981"/>
                            <TextBlock Text="Notebooks, " VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="11" Foreground="#9ca3af"/>
                            <TextBlock Text="{Binding TotalUploadedPages}" FontSize="24" FontWeight="Bold" Foreground="#10b981"/>
                            <TextBlock Text="Pages" VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="11" Foreground="#9ca3af"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="3" Background="White" CornerRadius="8" 
                        BoxShadow="0 2 10 0 #10000000" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Failed" Foreground="#666" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding TotalFailedNotebooks}" FontSize="24" FontWeight="Bold" Foreground="#ef4444"/>
                            <TextBlock Text="Notebooks, " VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="11" Foreground="#9ca3af"/>
                            <TextBlock Text="{Binding TotalFailedPages}" FontSize="24" FontWeight="Bold" Foreground="#ef4444"/>
                            <TextBlock Text="Pages" VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="11" Foreground="#9ca3af"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- Action Buttons and Progress -->
            <Border Background="White" CornerRadius="8" BoxShadow="0 2 10 0 #10000000" Padding="20">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="15">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                        <Button Content="Process Queue" 
                                Command="{Binding ProcessQueueCommand}"
                                IsVisible="{Binding !IsSyncing}"
                                Classes="primary"/>
                        <Button Content="Stop Sync" 
                                Command="{Binding StopSyncCommand}"
                                IsVisible="{Binding IsSyncing}"
                                Classes="danger"/>
                        <Button Content="Retry Failed" 
                                Command="{Binding RetryFailedCommand}"
                                IsEnabled="{Binding !IsSyncing}"/>
                        <Button Content="Clear Completed" 
                                Command="{Binding ClearCompletedCommand}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1" IsVisible="{Binding IsSyncing}">
                        <TextBlock Text="{Binding SyncProgress}" Margin="0,0,0,5"/>
                        <ProgressBar Classes="glowing" IsIndeterminate="False" Maximum="100" Value="100" Height="4" Foreground="#10b981" Background="#e5e7eb"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Recent Files Table -->
            <Border Background="White" CornerRadius="8" BoxShadow="0 2 10 0 #10000000" Padding="20">
                <StackPanel>
                    <TextBlock Text="Recent Files" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    
                    <DataGrid ItemsSource="{Binding SyncItems}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              MinHeight="300"
                              MaxHeight="500"
                              IsReadOnly="True">
                        <DataGrid.Styles>
                            <Style Selector="DataGridRow">
                                <Setter Property="ContextMenu">
                                    <ContextMenu>
                                        <MenuItem Header="Cancel Sync" 
                                                  Command="{ReflectionBinding $parent[UserControl].DataContext.CancelSyncCommand}" 
                                                  CommandParameter="{Binding}" />
                                        <Separator/>
                                        <MenuItem Header="Copy Virtual Path" 
                                                  Command="{ReflectionBinding $parent[UserControl].DataContext.CopyTextCommand}" 
                                                  CommandParameter="{ReflectionBinding VirtualPath}" />
                                        <MenuItem Header="Copy Status" 
                                                  Command="{ReflectionBinding $parent[UserControl].DataContext.CopyTextCommand}" 
                                                  CommandParameter="{ReflectionBinding StatusDisplay}" />
                                        <MenuItem Header="Copy Received Time" 
                                                  Command="{ReflectionBinding $parent[UserControl].DataContext.CopyTextCommand}" 
                                                  CommandParameter="{ReflectionBinding ReceivedTime}" />
                                        <MenuItem Header="Copy OneNote URL" 
                                                  Command="{ReflectionBinding $parent[UserControl].DataContext.CopyUrlCommand}" 
                                                  CommandParameter="{ReflectionBinding OneNoteUrl}" 
                                                  IsVisible="{ReflectionBinding OneNoteUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <MenuItem Header="Copy Error Message" 
                                                  Command="{ReflectionBinding $parent[UserControl].DataContext.CopyTextCommand}" 
                                                  CommandParameter="{ReflectionBinding LastError}" 
                                                  IsVisible="{ReflectionBinding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </ContextMenu>
                                </Setter>
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Virtual Path" 
                                                Binding="{Binding VirtualPath, Mode=OneWay}" 
                                                Width="*"/>
                            <DataGridTemplateColumn Header="Status" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:SyncItem">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding StatusDisplay}" VerticalAlignment="Center" 
                                                       IsVisible="{Binding IsNotUploading}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsUploading}">
                                                <TextBlock Text="{Binding StatusDisplay}" VerticalAlignment="Center" />
                                                <ProgressBar Classes="glowing"
                                                             IsIndeterminate="False" 
                                                             Value="{Binding UploadProgress}"
                                                             Maximum="{Binding UploadMaxProgress}"
                                                             Width="80" Height="8" MinWidth="80" MinHeight="8" 
                                                             VerticalAlignment="Center"
                                                             CornerRadius="4"
                                                             Foreground="#16a34a"
                                                             Background="#e5e7eb" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Time" 
                                                Binding="{Binding ReceivedTime, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}', Mode=OneWay}" 
                                                Width="180"/>
                            <DataGridTemplateColumn Header="OneNote Page" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:SyncItem">
                                        <Panel Margin="10,0">
                                            <!-- Success State: OneNote Link -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" 
                                                        IsVisible="{Binding OneNoteUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <Button Command="{ReflectionBinding $parent[UserControl].DataContext.CopyUrlCommand}"
                                                        CommandParameter="{Binding OneNoteUrl}"
                                                        ToolTip.Tip="Copy Link"
                                                        Classes="small stroke"
                                                        Padding="5"
                                                        CornerRadius="4">
                                                    <PathIcon Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" Width="12" Height="12"/>
                                                </Button>
                                                <Button Command="{ReflectionBinding $parent[UserControl].DataContext.OpenUrlCommand}"
                                                        CommandParameter="{Binding OneNoteUrl}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4"
                                                        Cursor="Hand"
                                                        ToolTip.Tip="{Binding OneNoteUrl}">
                                                    <TextBlock Text="{Binding OneNoteUrl}" Foreground="#2563eb" TextDecorations="Underline" TextTrimming="CharacterEllipsis" MaxWidth="600" />
                                                </Button>
                                            </StackPanel>

                                            <!-- Failure State: Error Message -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" 
                                                        IsVisible="{Binding OneNoteUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                <TextBlock Text="{Binding LastError}" 
                                                           Foreground="#ef4444" 
                                                           FontStyle="Italic"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis" 
                                                           MaxWidth="600" />
                                            </StackPanel>
                                        </Panel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>